# CurManLight Arena — public browser configuration only.
# Never place service-role keys, passwords or private secrets in VITE_* variables.

# Existing optional Google integration
VITE_GOOGLE_CLIENT_ID=

# H2B optional shared workspace foundation
# Leave both empty to keep Arena in local-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
