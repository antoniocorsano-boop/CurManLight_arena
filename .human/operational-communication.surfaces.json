        "data-revision-stage=\"sharing\"",
        "data-revision-stage=\"compare\"",
        "data-revision-stage=\"team-outcome\"",
        "mode=\"status\"",
        "mode=\"compare\"",
        "mode=\"record\"",
        "data-team-comparison-blocked-by-share",
        "Condivisione verificata",
        "Apri il confronto del gruppo",
        "Registra l’esito del gruppo",
        "data-curriculum-work-session-complete"
      ]
    },
    {
      "id": "revisione-scheda-personale",
      "path": "src/features/curriculum/components/RevisioneTab.tsx",
