        "data-team-coordination-workspace",
        "data-team-coordination-mode=\"status\"",
        "data-team-coordination-mode=\"compare\"",
        "data-team-coordination-mode=\"record\"",
        "Porta questo punto all’esito",
        "Registra l’esito del gruppo",
        "allCurrentOutcomesRecorded",
        "recordTeamOutcome",
        "non approvazione istituzionale"
      ]
    },
    {
      "id": "profilo-di-lavoro-personale",
      "path": "src/features/session/components/PersonalWorkProfileModal.tsx",
      "status": "guided-setup",
      "reason": "È una configurazione iniziale intenzionalmente guidata: una quota maggiore di testo formativo è ammessa, purché non confonda profilo personale, incarico verificato e autorità."
    }
