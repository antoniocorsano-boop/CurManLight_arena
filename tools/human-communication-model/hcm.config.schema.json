{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curmanlight.example/schemas/hcm-config-v1.json",
  "title": "Human Communication Model configuration",
  "type": "object",
  "required": [
    "human_communication_model_version",
    "profile",
    "product",
    "principles",
    "roles",
    "task_phases",
    "terminology",
    "memory",
    "authority"
  ],
  "properties": {
    "human_communication_model_version": { "type": "string", "pattern": "^1\\." },
    "profile": { "enum": ["HCM-L1", "HCM-L2", "HCM-L3"] },
    "product": {
      "type": "object",
      "required": ["id", "default_locale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "default_locale": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": true
    },
    "principles": {
      "type": "object",
      "required": [
        "role_aware_language",
        "task_phase_aware_tone",
        "progressive_terminology",
        "memory_is_context_not_authority",
        "canonical_state_independent_from_copy"
      ],
      "additionalProperties": { "type": "boolean" }
    },
    "roles": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": {
        "type": "object",
        "required": ["label", "tone"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "tone": { "enum": ["plain", "operational", "facilitative", "formal", "technical"] }
        },
        "additionalProperties": false
      }
    },
    "task_phases": {
      "type": "object",
      "required": ["ORIENT", "EXPLORE", "ACT", "REVIEW", "DECIDE", "RECOVER", "COMPLETE"],
      "additionalProperties": {
        "enum": ["plain", "descriptive", "operational", "precise", "formal", "recovery", "confirmatory"]
      }
    },
    "terminology": {
      "type": "object",
      "required": ["primary_layer", "technical_layer", "forbidden_primary_patterns"],
      "properties": {
        "primary_layer": { "const": "human" },
        "technical_layer": { "const": "progressive-disclosure" },
        "forbidden_primary_patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "domain_terms_allowed_when_task_relevant": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": ["rememberable", "canonical_source_required", "canonical_records_are_not_memory"],
      "properties": {
        "rememberable": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "canonical_source_required": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "canonical_records_are_not_memory": { "const": true }
      }
    },
    "authority": {
      "type": "object",
      "required": ["role_never_implies_authority", "copy_never_grants_capability", "verified_authority_must_come_from_domain"],
      "properties": {
        "role_never_implies_authority": { "const": true },
        "copy_never_grants_capability": { "const": true },
        "verified_authority_must_come_from_domain": { "const": true }
      }
    }
  },
  "additionalProperties": true
}
