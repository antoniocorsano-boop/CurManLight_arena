{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curmanlight.local/contracts/CURRICULUM_SNAPSHOT_V1.schema.json",
  "title": "CurriculumSnapshot v1 — ECO-01 profile of CML_CURRICULUM_RELEASE_CONTRACT_V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "contractVersion",
    "sourceHandoffFormat",
    "sourceContextContract",
    "curriculumId",
    "curriculumVersionRef",
    "authorityState",
    "structuralFingerprint",
    "applicabilityContext",
    "provenanceRefs",
    "planningSemantics",
    "issuedAt",
    "privacyClass",
    "downstreamPolicy"
  ],
  "properties": {
    "contract": {
      "const": "CML_CURRICULUM_RELEASE_CONTRACT_V1"
    },
    "contractVersion": {
      "const": 1
    },
    "sourceHandoffFormat": {
      "const": "CML_LOCAL_HANDOFF_V2"
    },
    "sourceContextContract": {
      "const": "CML_CURRICULUM_CONTEXT_V1"
    },
    "authorityState": {
      "enum": [
        "APPROVED",
        "PROVISIONAL_COMPLETE"
      ]
    },
    "structuralFingerprint": {
      "type": "object",
      "required": [
        "algorithm",
        "version",
        "hash"
      ],
      "properties": {
        "algorithm": {
          "const": "fnv1a"
        },
        "version": {
          "const": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "applicabilityContext": {
      "type": "object",
      "required": [
        "institutionRef",
        "schoolYearRef",
        "disciplineRef",
        "gradeRef",
        "applicabilityStatus",
        "transitionRuleRef"
      ],
      "properties": {
        "schoolYearRef": {
          "type": "string",
          "minLength": 1
        },
        "disciplineRef": {
          "type": "string",
          "minLength": 1
        },
        "gradeRef": {
          "type": "string",
          "minLength": 1
        },
        "applicabilityStatus": {
          "enum": [
            "APPLICABLE",
            "TRANSITIONAL"
          ]
        }
      }
    },
    "provenanceRefs": {
      "type": "array",
      "minItems": 1
    },
    "planningSemantics": {
      "type": "object",
      "required": [
        "requirements",
        "nodeRefs"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1
        },
        "nodeRefs": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "privacyClass": {
      "const": "PROFESSIONAL_NON_PERSONAL"
    },
    "downstreamPolicy": {
      "type": "object",
      "required": [
        "targetProduct",
        "importMode",
        "acceptanceRequired",
        "automaticWriteAllowed"
      ],
      "properties": {
        "targetProduct": {
          "const": "DOCENTE_OS"
        },
        "importMode": {
          "const": "PREVIEW_ONLY"
        },
        "acceptanceRequired": {
          "const": true
        },
        "automaticWriteAllowed": {
          "const": false
        }
      }
    }
  }
}
