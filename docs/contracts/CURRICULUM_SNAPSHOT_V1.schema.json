{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curmanlight.local/contracts/CURRICULUM_SNAPSHOT_V1.schema.json",
  "title": "CurriculumSnapshot v1 — ECO-01 profile of CML_CURRICULUM_RELEASE_CONTRACT_V1",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "canonicalRef": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "namespace",
        "entityType",
        "entityId"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "type": "string",
          "minLength": 1
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirementRef": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "requirementId",
        "kind",
        "authorityLevel",
        "curriculumNodeRef",
        "coverageRequired",
        "sourceRefs"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "authorityLevel": {
          "type": "string",
          "minLength": 1
        },
        "curriculumNodeRef": {
          "$ref": "#/$defs/canonicalRef"
        },
        "coverageRequired": {
          "type": "boolean"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/canonicalRef"
          }
        },
        "transitionOriginRef": {
          "$ref": "#/$defs/canonicalRef"
        }
      }
    }
  },
  "required": [
    "contract",
    "contractVersion",
    "sourceHandoffFormat",
    "sourceContextContract",
    "curriculumId",
    "curriculumVersionRef",
    "authorityState",
    "structuralFingerprint",
    "applicabilityContext",
    "provenanceRefs",
    "planningSemantics",
    "issuedAt",
    "privacyClass",
    "downstreamPolicy"
  ],
  "properties": {
    "contract": {
      "const": "CML_CURRICULUM_RELEASE_CONTRACT_V1"
    },
    "contractVersion": {
      "const": 1
    },
    "sourceHandoffFormat": {
      "const": "CML_LOCAL_HANDOFF_V2"
    },
    "sourceContextContract": {
      "const": "CML_CURRICULUM_CONTEXT_V1"
    },
    "curriculumId": {
      "$ref": "#/$defs/canonicalRef"
    },
    "curriculumVersionRef": {
      "$ref": "#/$defs/canonicalRef"
    },
    "authorityState": {
      "enum": [
        "APPROVED",
        "PROVISIONAL_COMPLETE"
      ]
    },
    "authorityReceiptRef": {
      "$ref": "#/$defs/canonicalRef"
    },
    "structuralFingerprint": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "algorithm",
        "version",
        "hash"
      ],
      "properties": {
        "algorithm": {
          "const": "fnv1a"
        },
        "version": {
          "const": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "applicabilityContext": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "institutionRef",
        "schoolYearRef",
        "disciplineRef",
        "gradeRef",
        "applicabilityStatus",
        "transitionRuleRef"
      ],
      "properties": {
        "institutionRef": {
          "$ref": "#/$defs/canonicalRef"
        },
        "schoolYearRef": {
          "type": "string",
          "minLength": 1
        },
        "disciplineRef": {
          "type": "string",
          "minLength": 1
        },
        "gradeRef": {
          "type": "string",
          "minLength": 1
        },
        "sectionRef": {
          "type": "string",
          "minLength": 1
        },
        "cohortRef": {
          "type": "string",
          "minLength": 1
        },
        "applicabilityStatus": {
          "enum": [
            "APPLICABLE",
            "TRANSITIONAL"
          ]
        },
        "transitionRuleRef": {
          "$ref": "#/$defs/canonicalRef"
        }
      },
      "anyOf": [
        {
          "required": [
            "sectionRef"
          ]
        },
        {
          "required": [
            "cohortRef"
          ]
        }
      ]
    },
    "provenanceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/canonicalRef"
      }
    },
    "planningSemantics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "requirements",
        "nodeRefs"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirementRef"
          }
        },
        "nodeRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/canonicalRef"
          }
        }
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "privacyClass": {
      "const": "PROFESSIONAL_NON_PERSONAL"
    },
    "downstreamPolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "targetProduct",
        "importMode",
        "acceptanceRequired",
        "automaticWriteAllowed"
      ],
      "properties": {
        "targetProduct": {
          "const": "DOCENTE_OS"
        },
        "importMode": {
          "const": "PREVIEW_ONLY"
        },
        "acceptanceRequired": {
          "const": true
        },
        "automaticWriteAllowed": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authorityState": {
            "const": "APPROVED"
          }
        },
        "required": [
          "authorityState"
        ]
      },
      "then": {
        "required": [
          "authorityReceiptRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authorityState": {
            "const": "PROVISIONAL_COMPLETE"
          }
        },
        "required": [
          "authorityState"
        ]
      },
      "then": {
        "not": {
          "required": [
            "authorityReceiptRef"
          ]
        }
      }
    }
  ]
}
